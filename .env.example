# Copie para .env e troque os valores. O .env não vai para o Git.
# Valores só para o ambiente de desenvolvimento local (docker-compose.yml).

POSTGRES_PASSWORD=troque-admin
PORTAL_DDL_SENHA=troque-ddl
SVC_LOGISTICA_SENHA=troque-logistica
SVC_TRANSPORTADORAS_SENHA=troque-transportadoras

# Token (D25). RS256 é o formato do grupo de Autenticação: os serviços validam
# com as chaves públicas do JWKS. No ambiente da turma, use o JWKS pelo gateway
# (http://gateway:8080/.well-known/jwks.json).
JWT_ALGORITHM=RS256
AUTH_JWKS_URL=http://usuarios-falso:8101/.well-known/jwks.json
# Só com JWT_ALGORITHM=HS256 (formato do kit atual): a mesma chave do
# usuarios-service do kit, com 32 caracteres ou mais.
JWT_SECRET_KEY=troque-por-uma-chave-com-pelo-menos-32-caracteres

LOG_LEVEL=INFO

# Prazos da cotação (D4). Para testar a escolha automática sem esperar 12 h,
# use, por exemplo, PRAZO_DECISAO_SEGUNDOS=30.
RODADA_COTACAO_SEGUNDOS=10
PRAZO_DECISAO_SEGUNDOS=43200

# De quanto em quanto tempo (real) o caminhão anda no mapa (D10).
RASTREIO_INTERVALO_SEGUNDOS=30
