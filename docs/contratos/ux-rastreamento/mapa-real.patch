 // Produto não consta na fixture RAS-A; texto da especificação (UX-RAS-05). Ver BLOQUEIOS.md.
 const RAS_PRODUTO = 'Soja';
 
+// ---------- Mapa real do rastreamento (Leaflet) ----------
+// Distância em km entre dois pontos [lat, lon] (haversine), para achar o ponto do progresso na rota.
+function distanciaKm([lat1, lon1], [lat2, lon2]) {
+  const rad = (g) => (g * Math.PI) / 180;
+  const a = Math.sin(rad(lat2 - lat1) / 2) ** 2 + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(rad(lon2 - lon1) / 2) ** 2;
+  return 2 * 6371 * Math.asin(Math.sqrt(a));
+}
+
+// Divide a rota no ponto de `fracao` (0 a 1) da distância: trecho percorrido, trecho restante e o ponto.
+function dividirRota(rota, fracao) {
+  const trechos = rota.slice(1).map((p, i) => distanciaKm(rota[i], p));
+  const alvo = trechos.reduce((s, d) => s + d, 0) * Math.min(Math.max(fracao, 0), 1);
+  let andado = 0;
+  for (let i = 0; i < trechos.length; i += 1) {
+    if (andado + trechos[i] >= alvo) {
+      const f = trechos[i] ? (alvo - andado) / trechos[i] : 0;
+      const ponto = [rota[i][0] + (rota[i + 1][0] - rota[i][0]) * f, rota[i][1] + (rota[i + 1][1] - rota[i][1]) * f];
+      return { percorrida: [...rota.slice(0, i + 1), ponto], restante: [ponto, ...rota.slice(i + 1)], ponto };
+    }
+    andado += trechos[i];
+  }
+  return { percorrida: rota, restante: [rota[rota.length - 1]], ponto: rota[rota.length - 1] };
+}
+
+function desenharMapaReal(Leaflet, alvo, r) {
+  const mapa = Leaflet.map(alvo, { scrollWheelZoom: false });
+  // Créditos em texto, sem link: a tela não pode ter links externos ativos (UX-RAS-06/B).
+  mapa.attributionControl.setPrefix('Leaflet');
+  Leaflet.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
+    maxZoom: 18, attribution: '&copy; colaboradores do OpenStreetMap (ODbL)',
+  }).addTo(mapa);
+  const { percorrida, restante, ponto } = dividirRota(r.rota, r.rota_percentual / 100);
+  Leaflet.polyline(restante, { color: '#98A2B3', weight: 4, dashArray: '8 8' }).addTo(mapa);
+  Leaflet.polyline(percorrida, { color: '#3F7F00', weight: 5, lineCap: 'round' }).addTo(mapa);
+  const pino = (classe) => Leaflet.divIcon({ className: '', html: `<div class="map-pin ${classe}"></div>`, iconSize: [16, 16], iconAnchor: [8, 8] });
+  const aoLado = { permanent: true, direction: 'right', offset: [10, 0] };
+  Leaflet.marker(r.rota[0], { icon: pino(''), keyboard: false }).addTo(mapa).bindTooltip(`Origem: ${esc(r.origem)}`, aoLado);
+  Leaflet.marker(r.rota[r.rota.length - 1], { icon: pino('is-dest'), keyboard: false }).addTo(mapa)
+    .bindTooltip(`Destino: ${esc(r.destino)}`, { ...aoLado, direction: 'left', offset: [-10, 0] });
+  Leaflet.marker(ponto, {
+    icon: Leaflet.divIcon({ className: '', html: '<div class="map-truck">▶</div>', iconSize: [34, 34], iconAnchor: [17, 17] }),
+    keyboard: false, zIndexOffset: 1000,
+  }).addTo(mapa).bindTooltip(`Veículo ${esc(r.veiculo)} · ${r.rota_percentual}% da rota`, { permanent: true, direction: 'top', offset: [0, -18] });
+  mapa.fitBounds(Leaflet.latLngBounds(r.rota), { padding: [30, 30] });
+}
